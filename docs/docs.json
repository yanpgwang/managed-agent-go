{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "sequoia",
  "name": "Mango",
  "description": "Durable, self-hosted Claude Managed Agents runtime",
  "colors": {
    "primary": "#3157D5",
    "light": "#476CE0",
    "dark": "#8BA4FF"
  },
  "appearance": {
    "default": "system"
  },
  "favicon": "/logo/mango-mark.svg",
  "logo": {
    "light": "/logo/mango-logo.svg",
    "dark": "/logo/mango-logo-dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Understand Mango",
        "pages": ["compatibility", "architecture", "roadmap"]
      },
      {
        "group": "Run it",
        "pages": ["sandboxes", "deployment"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Compatibility",
        "href": "/compatibility"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/yanpgwang/managed-agent-go"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yanpgwang/managed-agent-go"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/quickstart"
    },
    {
      "source": "/api",
      "destination": "/compatibility"
    },
    {
      "source": "/api/:slug*",
      "destination": "/compatibility"
    },
    {
      "source": "/architecture/:slug*",
      "destination": "/architecture"
    },
    {
      "source": "/compatibility/core-v1",
      "destination": "/compatibility"
    },
    {
      "source": "/provenance",
      "destination": "/compatibility"
    }
  ]
}
