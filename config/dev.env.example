# Copy this file to ~/.config/mango/dev.env and chmod it 0600.
# Keep values empty until the corresponding provider is used.
# Values are loaded literally; do not add shell quotes or export statements.

# Select one backend for the API/worker process.
MANAGED_AGENT_SANDBOX=local

# Anthropic-shaped Messages endpoint. Live-model tests and a real worker use
# only POST /v1/messages; keep the key empty until deliberately configured.
MANAGED_AGENT_MODEL_BASE_URL=
MANAGED_AGENT_MODEL_API_KEY=
MANAGED_AGENT_MODEL_ID=
MANAGED_AGENT_MODEL_AUTH=x-api-key

# Files API. A bucket enables the five Files routes; leave it empty to keep
# Files disabled. Static credentials are optional, but must be set together.
# PATH_STYLE and CREATE_BUCKET are normally development-only settings for MinIO.
MANAGED_AGENT_FILE_S3_ENDPOINT=
MANAGED_AGENT_FILE_S3_REGION=us-east-1
MANAGED_AGENT_FILE_S3_BUCKET=
MANAGED_AGENT_FILE_S3_ACCESS_KEY=
MANAGED_AGENT_FILE_S3_SECRET_KEY=
MANAGED_AGENT_FILE_S3_PATH_STYLE=false
MANAGED_AGENT_FILE_S3_CREATE_BUCKET=false
MANAGED_AGENT_FILE_UPLOAD_TEMP_DIR=

# Vault API. Mount a JSON keyring containing an active_key_id and one or more
# standard-base64 32-byte AES keys. The active key encrypts new values; retained
# older keys remain decrypt-only during rotation. Empty disables Vault routes.
MANAGED_AGENT_VAULT_KEYRING_FILE=

# E2B Cloud.
E2B_API_KEY=
E2B_API_URL=https://api.e2b.app
E2B_TEMPLATE_ID=base
E2B_DOMAIN=e2b.app
E2B_IDLE_TIMEOUT=5m

# Tencent CubeSandbox (self-hosted).
CUBE_API_URL=http://127.0.0.1:3000
CUBE_API_KEY=
CUBE_TEMPLATE_ID=
CUBE_SANDBOX_DOMAIN=cube.app
CUBE_PROXY_NODE_IP=
CUBE_PROXY_PORT_HTTP=80
CUBE_PROXY_SCHEME=http
CUBE_IDLE_TIMEOUT=5m

# OpenSandbox (self-hosted). A full URL is accepted as the domain.
OPEN_SANDBOX_DOMAIN=http://127.0.0.1:8080
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_IMAGE=python:3.12-slim
OPEN_SANDBOX_USE_SERVER_PROXY=false

# Daytona Cloud or self-hosted.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=
DAYTONA_IMAGE=python:3.12-slim
DAYTONA_AUTO_PAUSE_MINUTES=15
