# Copy this file to ~/.config/mango/dev.env and chmod it 0600.
# Keep values empty until the corresponding provider is used.
# Values are loaded literally; do not add shell quotes or export statements.

# Select one backend for the API/worker process.
MANAGED_AGENT_SANDBOX=local

# API authentication. A comma- or whitespace-separated list of
# "<key-id>:<secret>" entries; the key id is a non-secret label used in logs.
# Leave empty for the zero-config local path: authentication is disabled and
# `serve` warns at startup. `serve -strict` refuses to start without keys.
MANAGED_AGENT_API_KEYS=
# Both documented credential headers (`x-api-key` and `authorization: Bearer`)
# are accepted by default. Set this to true only if your ingress already uses
# `Authorization` for something else; it removes a documented header.
MANAGED_AGENT_AUTH_DISABLE_AUTHORIZATION_HEADER=false

# Runtime limits. Every value below has a working default; see
# docs/deployment.md for precedence and sizing guidance.
MANAGED_AGENT_SHUTDOWN_TIMEOUT=30s
MANAGED_AGENT_DB_MAX_CONNS=10
MANAGED_AGENT_DB_MIN_CONNS=2
MANAGED_AGENT_DB_MAX_CONN_LIFETIME=30m
MANAGED_AGENT_DB_MAX_CONN_IDLE_TIME=5m
MANAGED_AGENT_DB_HEALTH_CHECK_PERIOD=1m
MANAGED_AGENT_DB_STATEMENT_TIMEOUT=30s
MANAGED_AGENT_WORKER_MAX_CONCURRENT_ACTIVITIES=32
MANAGED_AGENT_WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=32
MANAGED_AGENT_WORKER_ACTIVITY_POLLERS=2
MANAGED_AGENT_WORKER_WORKFLOW_POLLERS=2
MANAGED_AGENT_WORKER_DRAIN_TIMEOUT=30s

# Anthropic-shaped Messages endpoint. Live-model tests and a real worker use
# only POST /v1/messages; keep the key empty until deliberately configured.
MANAGED_AGENT_MODEL_BASE_URL=
MANAGED_AGENT_MODEL_API_KEY=
MANAGED_AGENT_MODEL_ID=
MANAGED_AGENT_MODEL_AUTH=x-api-key

# E2B Cloud.
E2B_API_KEY=
E2B_API_URL=https://api.e2b.app
E2B_TEMPLATE_ID=base
E2B_DOMAIN=e2b.app
E2B_IDLE_TIMEOUT=5m

# Tencent CubeSandbox (self-hosted).
CUBE_API_URL=http://127.0.0.1:3000
CUBE_API_KEY=
CUBE_TEMPLATE_ID=
CUBE_SANDBOX_DOMAIN=cube.app
CUBE_PROXY_NODE_IP=
CUBE_PROXY_PORT_HTTP=80
CUBE_PROXY_SCHEME=http
CUBE_IDLE_TIMEOUT=5m

# OpenSandbox (self-hosted). A full URL is accepted as the domain.
OPEN_SANDBOX_DOMAIN=http://127.0.0.1:8080
OPEN_SANDBOX_API_KEY=
OPEN_SANDBOX_IMAGE=python:3.12-slim
OPEN_SANDBOX_USE_SERVER_PROXY=false

# Daytona Cloud or self-hosted.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=
DAYTONA_IMAGE=python:3.12-slim
DAYTONA_AUTO_PAUSE_MINUTES=15
